<!--
  B89 · Cloudflare (wazuh/provider-ingestion/cloudflare/security.py). IDs reservados: 101500-101549.
  Auditoría de cuenta (b89.event_type=audit) y eventos de seguridad de zona (firewall). Monitor-only.
-->
<group name="b89_provider,cloudflare,">
  <rule id="101500" level="0">
    <decoded_as>json</decoded_as>
    <field name="b89.vendor">^cloudflare$</field>
    <description>B89 Cloudflare: evento del collector.</description>
    <options>no_full_log</options>
  </rule>

  <!-- Auditoría de cuenta -->
  <rule id="101501" level="3">
    <if_sid>101500</if_sid>
    <field name="b89.event_type">^audit$</field>
    <description>B89 Cloudflare: $(cloudflare.audit.action) sobre $(cloudflare.audit.resource_type) por $(cloudflare.audit.actor_email).</description>
    <options>no_full_log</options>
    <group>b89_audit,</group>
  </rule>

  <rule id="101502" level="5">
    <if_sid>101501</if_sid>
    <field name="cloudflare.audit.result">^false$</field>
    <description>B89 Cloudflare: acción fallida $(cloudflare.audit.action) sobre $(cloudflare.audit.resource_type) por $(cloudflare.audit.actor_email).</description>
    <options>no_full_log</options>
    <group>b89_audit,</group>
  </rule>

  <rule id="101503" level="5">
    <if_sid>101501</if_sid>
    <field name="cloudflare.audit.result">^true$</field>
    <field name="cloudflare.audit.action" type="pcre2" negate="yes">(?i)^(get|list|read|view|search)$</field>
    <field name="cloudflare.audit.resource_type" type="pcre2">^dns\.record$</field>
    <description>B89 Cloudflare: cambio DNS ($(cloudflare.audit.action)) en $(cloudflare.audit.zone_name) por $(cloudflare.audit.actor_email).</description>
    <options>no_full_log</options>
    <mitre><id>T1584.002</id></mitre>
    <group>b89_audit,b89_dns_change,</group>
  </rule>

  <rule id="101504" level="8">
    <if_sid>101501</if_sid>
    <field name="cloudflare.audit.result">^true$</field>
    <field name="cloudflare.audit.action" type="pcre2" negate="yes">(?i)^(get|list|read|view|search)$</field>
    <field name="cloudflare.audit.resource_type" type="pcre2">(?i)(firewall|waf|ruleset|rate.?limit|access|zero.?trust|security|page.?shield|bot)</field>
    <description>B89 Cloudflare: cambio de control de seguridad ($(cloudflare.audit.action) $(cloudflare.audit.resource_type)) por $(cloudflare.audit.actor_email).</description>
    <options>no_full_log</options>
    <mitre><id>T1562</id></mitre>
    <group>b89_audit,b89_defense_evasion,</group>
  </rule>

  <rule id="101505" level="10">
    <if_sid>101504</if_sid>
    <field name="cloudflare.audit.action" type="pcre2">(?i)^(delete|deleted|disable|disabled|remove|removed)$</field>
    <description>B89 Cloudflare: control de seguridad eliminado/deshabilitado ($(cloudflare.audit.resource_type)) por $(cloudflare.audit.actor_email).</description>
    <options>no_full_log</options>
    <mitre><id>T1562.007</id></mitre>
    <group>b89_audit,b89_defense_evasion,</group>
  </rule>

  <rule id="101506" level="10">
    <if_sid>101501</if_sid>
    <field name="cloudflare.audit.result">^true$</field>
    <field name="cloudflare.audit.action" type="pcre2" negate="yes">(?i)^(get|list|read|view|search)$</field>
    <field name="cloudflare.audit.resource_type" type="pcre2">(?i)(token|member|api.?key|role|two.?factor|sso|organization|^user$|^account$)</field>
    <description>B89 Cloudflare: cambio de identidad/credenciales ($(cloudflare.audit.action) $(cloudflare.audit.resource_type)) por $(cloudflare.audit.actor_email).</description>
    <options>no_full_log</options>
    <mitre><id>T1098</id></mitre>
    <group>b89_audit,b89_persistence,</group>
  </rule>

  <rule id="101507" level="12">
    <if_sid>101501</if_sid>
    <field name="cloudflare.audit.result">^true$</field>
    <field name="cloudflare.audit.resource_type">^zone$</field>
    <field name="cloudflare.audit.action" type="pcre2">(?i)^(delete|deleted)$</field>
    <description>B89 Cloudflare: zona $(cloudflare.audit.zone_name) eliminada por $(cloudflare.audit.actor_email).</description>
    <options>no_full_log</options>
    <mitre><id>T1485</id></mitre>
    <group>b89_audit,b89_impact,</group>
  </rule>

  <!-- Eventos de seguridad de zona (WAF, reglas personalizadas, rate limiting, bots) -->
  <rule id="101510" level="3">
    <if_sid>101500</if_sid>
    <field name="b89.event_type">^firewall$</field>
    <field name="cloudflare.firewall.action" type="pcre2">(?i)^(block|drop|challenge|managed_challenge|jschallenge|js_challenge|challenge_failed|connection_close)$</field>
    <description>B89 Cloudflare: $(cloudflare.firewall.action) de $(cloudflare.firewall.client_ip) en $(cloudflare.firewall.host) ($(cloudflare.firewall.source)).</description>
    <options>no_full_log</options>
    <group>b89_waf,</group>
  </rule>

  <rule id="101511" level="5">
    <if_sid>101500</if_sid>
    <field name="b89.event_type">^firewall$</field>
    <field name="cloudflare.firewall.action">^log$</field>
    <description>B89 Cloudflare: regla $(cloudflare.firewall.rule_id) coincidió solo en modo log para $(cloudflare.firewall.client_ip) en $(cloudflare.firewall.host).</description>
    <options>no_full_log</options>
    <group>b89_waf,</group>
  </rule>

  <rule id="101512" level="3">
    <if_sid>101500</if_sid>
    <field name="b89.event_type">^firewall$</field>
    <description>B89 Cloudflare: evento de seguridad $(cloudflare.firewall.action) en $(cloudflare.firewall.host).</description>
    <options>no_full_log</options>
    <group>b89_waf,</group>
  </rule>

  <rule id="101513" level="10" frequency="20" timeframe="300">
    <if_matched_sid>101510</if_matched_sid>
    <same_field>cloudflare.firewall.client_ip</same_field>
    <description>B89 Cloudflare: 20+ bloqueos/desafíos para $(cloudflare.firewall.client_ip) en 5 min; ataque sostenido contra el perímetro.</description>
    <options>no_full_log</options>
    <mitre><id>T1190</id><id>T1595</id></mitre>
    <group>b89_waf,b89_attack,</group>
  </rule>
  <!-- Preserve visibility for Logpush datasets without a specialized detector. -->
  <rule id="101514" level="3">
    <if_sid>101500</if_sid>
    <field name="b89.event_type">^logpush$</field>
    <description>B89 Cloudflare: registro Logpush recibido; revisar el conjunto de datos antes de clasificar.</description>
    <options>no_full_log</options>
    <group>b89_logpush,</group>
  </rule>

  <!-- HTTP (Logpush http_requests o traffic.py): cada petición entra a nivel 0 (sin alerta); alertan los patrones. -->
  <rule id="101515" level="0">
    <if_sid>101500</if_sid>
    <field name="b89.event_type">^http$</field>
    <description>B89 Cloudflare: petición HTTP $(cloudflare.http.method) $(cloudflare.http.host)$(cloudflare.http.path) → $(cloudflare.http.status).</description>
    <options>no_full_log</options>
    <group>b89_http,</group>
  </rule>

  <rule id="101518" level="0">
    <if_sid>101515</if_sid>
    <field name="b89.source">^logpush$</field>
    <field name="cloudflare.http.status" type="pcre2">^4\d\d$</field>
    <description>B89 Cloudflare: respuesta 4xx a $(cloudflare.http.client_ip).</description>
    <options>no_full_log</options>
    <group>b89_http,</group>
  </rule>

  <rule id="101520" level="0">
    <if_sid>101515</if_sid>
    <field name="b89.source">^logpush$</field>
    <field name="cloudflare.http.status" type="pcre2">^5\d\d$</field>
    <description>B89 Cloudflare: error 5xx en $(cloudflare.http.host).</description>
    <options>no_full_log</options>
    <group>b89_http,</group>
  </rule>

  <!-- Backoffice de pagos (credenciales de empleados): acceso humano a /backoffice y /auth-service. -->
  <rule id="101530" level="0">
    <if_sid>101515, 101518, 101520</if_sid>
    <field name="cloudflare.http.host" type="pcre2">(?i)^((prodv2|stg|uat)-)?apipayments\.b89\.io$|^(stg|uat)?paymentsv2\.b89\.io$</field>
    <field name="cloudflare.http.path" type="pcre2">^/(backoffice|auth-service)/</field>
    <description>B89 Cloudflare: backoffice de pagos $(cloudflare.http.method) $(cloudflare.http.path) desde $(cloudflare.http.client_ip) ($(cloudflare.http.status)).</description>
    <options>no_full_log</options>
    <group>b89_http,b89_backoffice,</group>
  </rule>

  <rule id="101531" level="13">
    <if_sid>101530</if_sid>
    <field name="cloudflare.http.status" type="pcre2">^(2\d\d|304)$</field>
    <field name="cloudflare.http.asn_name" type="pcre2">(?i)(datacamp|amazon|google llc|google cloud|hetzner|\bovh|digitalocean|m247|leaseweb|constant company|vultr|choopa|linode|akamai|contabo|tencent|alibaba|oracle|microsoft|cdn77|packethub|g-core|gcore|ipxo|hostinger|scaleway|zenlayer|tefincom|nord|proton|mullvad|surfshark|express ?vpn|private internet|clouvider|datapacket|hostroyale|colocrossing|psychz|quadranet|buyvm|frantech|servers\.com|ionos|hostpapa|unified layer|bluehost|godaddy)</field>
    <description>B89 Cloudflare: sesión válida en el backoffice de pagos desde hosting/VPN ($(cloudflare.http.asn_name), $(cloudflare.http.country)) IP $(cloudflare.http.client_ip): $(cloudflare.http.method) $(cloudflare.http.path) el $(cloudflare.http.datetime) UTC. Posible uso de credenciales robadas.</description>
    <options>no_full_log</options>
    <mitre><id>T1078</id><id>T1550.001</id></mitre>
    <group>b89_http,b89_backoffice,b89_credential_misuse,</group>
  </rule>

  <rule id="101532" level="13">
    <if_sid>101530</if_sid>
    <field name="cloudflare.http.path" type="pcre2">(?i)/export</field>
    <field name="cloudflare.http.status" type="pcre2">^2\d\d$</field>
    <field name="cloudflare.http.country" type="pcre2" negate="yes">^PE$</field>
    <description>B89 Cloudflare: exportación de datos del backoffice ($(cloudflare.http.path)) desde $(cloudflare.http.country) IP $(cloudflare.http.client_ip) ($(cloudflare.http.asn_name)) el $(cloudflare.http.datetime) UTC. Posible exfiltración.</description>
    <options>no_full_log</options>
    <mitre><id>T1567</id><id>T1213</id></mitre>
    <group>b89_http,b89_backoffice,b89_exfiltration,</group>
  </rule>

  <rule id="101533" level="12">
    <if_sid>101530</if_sid>
    <field name="cloudflare.http.method">^POST$</field>
    <field name="cloudflare.http.path" type="pcre2">^/auth-service/v1/login$</field>
    <field name="cloudflare.http.status" type="pcre2">^2\d\d$</field>
    <field name="cloudflare.http.country" type="pcre2" negate="yes">^PE$</field>
    <description>B89 Cloudflare: login correcto al backoffice de pagos desde $(cloudflare.http.country) IP $(cloudflare.http.client_ip) ($(cloudflare.http.asn_name)) el $(cloudflare.http.datetime) UTC.</description>
    <options>no_full_log</options>
    <mitre><id>T1078</id></mitre>
    <group>b89_http,b89_backoffice,b89_credential_misuse,</group>
  </rule>

  <rule id="101516" level="6">
    <if_sid>101515, 101518, 101520</if_sid>
    <field name="cloudflare.http.path" type="pcre2">(?i)(/\.env|/\.git/|/\.aws/|/\.ssh/|wp-login\.php|xmlrpc\.php|/phpmyadmin|/etc/passwd|\.\./|%2e%2e%2f|/actuator|/server-status|/cgi-bin/|/\.DS_Store|/config\.json|/backup|\.sql$|\.bak$)</field>
    <description>B89 Cloudflare: sondeo de ruta sensible $(cloudflare.http.path) desde $(cloudflare.http.client_ip) en $(cloudflare.http.host) ($(cloudflare.http.status)).</description>
    <options>no_full_log</options>
    <mitre><id>T1595.003</id></mitre>
    <group>b89_http,b89_web_probe,</group>
  </rule>

  <rule id="101517" level="10" frequency="15" timeframe="120">
    <if_matched_sid>101516</if_matched_sid>
    <same_field>cloudflare.http.client_ip</same_field>
    <field name="b89.source">^logpush$</field>
    <description>B89 Cloudflare: escaneo de rutas sensibles desde $(cloudflare.http.client_ip): 15+ sondeos en 2 min.</description>
    <options>no_full_log</options>
    <mitre><id>T1595.003</id></mitre>
    <group>b89_http,b89_web_probe,b89_attack,</group>
  </rule>

  <rule id="101519" level="8" frequency="60" timeframe="120">
    <if_matched_sid>101518</if_matched_sid>
    <same_field>cloudflare.http.client_ip</same_field>
    <description>B89 Cloudflare: 60+ respuestas 4xx para $(cloudflare.http.client_ip) en 2 min; enumeración o fuerza bruta.</description>
    <options>no_full_log</options>
    <mitre><id>T1595</id></mitre>
    <group>b89_http,b89_attack,</group>
  </rule>

  <rule id="101521" level="9" frequency="50" timeframe="300">
    <if_matched_sid>101520</if_matched_sid>
    <same_field>cloudflare.http.host</same_field>
    <description>B89 Cloudflare: 50+ errores 5xx en $(cloudflare.http.host) en 5 min; origen caído o bajo carga.</description>
    <options>no_full_log</options>
    <mitre><id>T1499</id></mitre>
    <group>b89_http,b89_availability,</group>
  </rule>

  <rule id="101522" level="7">
    <if_sid>101515, 101518, 101520</if_sid>
    <field name="cloudflare.http.method" type="pcre2">^(TRACE|TRACK|CONNECT|PROPFIND|DEBUG)$</field>
    <description>B89 Cloudflare: método HTTP anómalo $(cloudflare.http.method) desde $(cloudflare.http.client_ip) en $(cloudflare.http.host).</description>
    <options>no_full_log</options>
    <mitre><id>T1595</id></mitre>
    <group>b89_http,b89_web_probe,</group>
  </rule>

  <!-- DNS (Logpush dns_logs o traffic.py, DNS autoritativo de Cloudflare) -->
  <rule id="101525" level="0">
    <if_sid>101500</if_sid>
    <field name="b89.event_type">^dns$</field>
    <description>B89 Cloudflare: consulta DNS $(cloudflare.dns.query) tipo $(cloudflare.dns.query_type).</description>
    <options>no_full_log</options>
    <group>b89_dns,</group>
  </rule>

  <rule id="101526" level="8">
    <if_sid>101525</if_sid>
    <field name="cloudflare.dns.query_type" type="pcre2">^(252|251|AXFR|IXFR)$</field>
    <description>B89 Cloudflare: intento de transferencia de zona ($(cloudflare.dns.query_type)) de $(cloudflare.dns.query) desde $(cloudflare.dns.client_ip).</description>
    <options>no_full_log</options>
    <mitre><id>T1590.002</id></mitre>
    <group>b89_dns,b89_recon,</group>
  </rule>

  <rule id="101527" level="0">
    <if_sid>101525</if_sid>
    <field name="b89.source">^logpush$</field>
    <field name="cloudflare.dns.response_code" type="pcre2">^(3|NXDOMAIN)$</field>
    <description>B89 Cloudflare: NXDOMAIN para $(cloudflare.dns.query).</description>
    <options>no_full_log</options>
    <group>b89_dns,</group>
  </rule>

  <rule id="101528" level="8" frequency="100" timeframe="120">
    <if_matched_sid>101527</if_matched_sid>
    <same_field>cloudflare.dns.client_ip</same_field>
    <description>B89 Cloudflare: 100+ NXDOMAIN desde $(cloudflare.dns.client_ip) en 2 min; enumeración de subdominios.</description>
    <options>no_full_log</options>
    <mitre><id>T1590.002</id></mitre>
    <group>b89_dns,b89_recon,</group>
  </rule>
</group>
