[Unit]
Description=B89 SecOps Core · worker de colas del SIEM B89 (avisos, ingesta, Graph)
After=network-online.target b89-core-api.service
Wants=network-online.target

[Service]
Type=simple
User=b89-core
Group=b89-core
WorkingDirectory=/opt/b89-core/current/worker
EnvironmentFile=/etc/b89-core/core.env
Environment=NODE_ENV=production B89_PROFILE=production B89_PROCESS_ROLE=worker
Environment=NODE_EXTRA_CA_CERTS=/opt/b89-core/current/certs/rds-global-bundle.pem
ExecStart=/opt/b89-core/current/node/bin/node dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM

MemoryHigh=512M
MemoryMax=768M
CPUQuota=50%
TasksMax=128

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadOnlyPaths=/opt/b89-core
UMask=0077

[Install]
WantedBy=multi-user.target
