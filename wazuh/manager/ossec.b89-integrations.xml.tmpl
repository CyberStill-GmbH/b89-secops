<!-- B89:integrations:begin — bloque administrado; no editar a mano. docs/07 y docs/06.
     Sustituir ${...} al aplicar. Los secretos se leen de Secrets Manager en el host. -->
<ossec_config>

  <!-- Fase 2 · Push de alertas a B89 (best-effort; el pull reconcilia). -->
  <integration>
    <name>custom-b89</name>
    <hook_url>${B89_INGEST_URL}</hook_url>   <!-- https://<api interna>/api/ingest/wazuh -->
    <api_key>${B89_INGEST_HMAC_KEY}</api_key>
    <level>7</level>
    <alert_format>json</alert_format>
  </integration>

  <!-- Fase 3 · Shuffle SOLO para enriquecimiento sin efectos (reputación de IP, etc.).
       Las acciones con efectos NO salen de aquí: las dispara B89 tras la aprobación. -->
  <!--
  <integration>
    <name>shuffle</name>
    <hook_url>${SHUFFLE_ENRICH_HOOK_URL}</hook_url>
    <level>10</level>
    <alert_format>json</alert_format>
  </integration>
  -->

  <!-- Fase 1 · Observabilidad sin Grafana (N1): logs de la API y del ALB hacia Wazuh.
       Credenciales: rol IAM de la instancia (logs:FilterLogEvents/GetLogEvents, s3:GetObject). -->
  <wodle name="aws-s3">
    <disabled>no</disabled>
    <interval>5m</interval>
    <run_on_start>yes</run_on_start>
    <skip_on_error>yes</skip_on_error>
    <service type="cloudwatchlogs">
      <aws_log_groups>${B89_API_LOG_GROUP}</aws_log_groups>   <!-- /b89-secops/demo/api -->
      <regions>${B89_AWS_REGION}</regions>
      <only_logs_after>${B89_LOGS_SINCE}</only_logs_after>    <!-- p. ej. 2026-OCT-13 -->
    </service>
    <bucket type="alb">
      <name>${B89_ALB_LOGS_BUCKET}</name>
      <regions>${B89_AWS_REGION}</regions>
      <only_logs_after>${B89_LOGS_SINCE}</only_logs_after>
    </bucket>
  </wodle>

</ossec_config>
<!-- B89:integrations:end -->
