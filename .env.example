B89_PROFILE=development
B89_API_HOST=127.0.0.1
B89_API_PORT=3000

POSTGRES_USER=b89
POSTGRES_PASSWORD=b89_local_only
POSTGRES_DB=b89_secops

B89_POSTGRES_HOST=127.0.0.1
B89_POSTGRES_PORT=5432
B89_POSTGRES_DATABASE=b89_secops
B89_POSTGRES_USERNAME=b89
B89_POSTGRES_PASSWORD_REF=secret://environment/POSTGRES_PASSWORD

B89_REDIS_HOST=127.0.0.1
B89_REDIS_PORT=6379

MINIO_ROOT_USER=b89_local
MINIO_ROOT_PASSWORD=change_this_local_password
B89_MINIO_ENDPOINT=127.0.0.1
B89_MINIO_PORT=9000
B89_MINIO_RAW_BUCKET=b89-raw-local
B89_MINIO_ACCESS_KEY_REF=secret://environment/MINIO_ROOT_USER
B89_MINIO_SECRET_KEY_REF=secret://environment/MINIO_ROOT_PASSWORD

B89_WAZUH_GATEWAY_BASE_URL=http://127.0.0.1:18080
B89_WAZUH_GATEWAY_ACCESS_TOKEN_REF=secret://environment/WAZUH_GATEWAY_ACCESS_TOKEN
B89_WAZUH_DATASET=wazuh-alerts
B89_WAZUH_CURSOR_SECRET_REF=secret://environment/WAZUH_CURSOR_HMAC
B89_WAZUH_CURSOR_TTL=1m
B89_WAZUH_MAX_RESPONSE_BYTES=10485760

# C-24: select B89_SECRET_PROVIDER_TYPE only after approving a real adapter.
# The production backend/identity/endpoint remain TO_BE_PROVIDED in source-inventory.yaml.
B89_SECRET_PROVIDER_TIMEOUT=5s
B89_SECRET_FINGERPRINT_KEY_REF=secret://environment/B89_SECRET_FINGERPRINT_KEY
