{
  "id": "e81e0bcd-7d47-5032-bddb-a86961ad1e45",
  "name": "B89 · Triage y enriquecimiento de alertas",
  "description": "Triage de solo lectura para alertas Wazuh de nivel ≥ 12: valida y deduplica, lee la prioridad B89 y el contexto del agente, deja una nota auditada en el incidente y avisa por el servicio de correo B89. Sin acciones con efectos (no requiere aprobación).",
  "start": "7ca91096-a20d-5840-be4c-dfcf03fdb04a",
  "actions": [
    {
      "id": "7ca91096-a20d-5840-be4c-dfcf03fdb04a",
      "label": "validar_y_deduplicar",
      "name": "execute_python",
      "app_name": "Shuffle Tools",
      "app_version": "1.2.0",
      "app_id": "",
      "environment": "Shuffle",
      "is_valid": true,
      "isStartNode": true,
      "description": "Valida el contrato v1, deduplica por alert.id (executionKey) y clasifica la fuente.",
      "authentication_id": "",
      "errors": [],
      "sharing": false,
      "private_id": "",
      "public": false,
      "parameters": [
        {
          "name": "code",
          "value": "import json\n# B89 · validar y deduplicar (contrato custom-b89-shuffle v1: sin usuario, IP ni full_log).\ndata = json.loads(r\"\"\"$exec\"\"\") if isinstance(r\"\"\"$exec\"\"\", str) else $exec\nalert = data.get(\"alert\", {})\nrule = alert.get(\"rule\", {})\ngroups = set(rule.get(\"groups\", []))\nif data.get(\"schemaVersion\") != \"1.0.0\" or data.get(\"source\") != \"wazuh\" or int(rule.get(\"level\", 0)) < 12:\n    print(json.dumps({\"valid\": \"false\", \"reason\": \"fuera de contrato\"}))\nelse:\n    source = next((s for g, s in [(\"office365\", \"m365\"), (\"aws\", \"aws\"), (\"bitdefender\", \"bitdefender\"),\n                                   (\"snyk\", \"snyk\"), (\"cloudflare\", \"cloudflare\"), (\"sshd\", \"linux\"),\n                                   (\"syscheck\", \"linux\")] if g in groups), \"otro\")\n    runbooks = {\"m365\": \"credenciales.md\", \"aws\": \"cloudtrail-y-auditoria.md\", \"bitdefender\": \"malware-edr.md\",\n                \"snyk\": \"vulnerabilidad-expuesta.md\", \"cloudflare\": \"oleada-waf.md\", \"linux\": \"credenciales.md#ssh\"}\n    print(json.dumps({\"valid\": \"true\", \"executionKey\": alert.get(\"id\"), \"source\": source,\n                      \"rule_id\": rule.get(\"id\"), \"level\": rule.get(\"level\"), \"description\": rule.get(\"description\"),\n                      \"chain\": \"true\" if \"b89_attack_chain\" in groups else \"false\",\n                      \"agent_id\": alert.get(\"agent\", {}).get(\"id\"),\n                      \"runbook\": \"docs/detection-engineering/runbooks/\" + runbooks.get(source, \"README.md\")}))\n",
          "required": false,
          "multiline": true,
          "id_": "",
          "variant": "STATIC_VALUE",
          "action_field": "",
          "example": "",
          "description": ""
        }
      ],
      "position": {
        "x": 200,
        "y": 0
      },
      "priority": 0,
      "execution_delay": 0
    },
