    {
      "id": "97662a14-be80-570d-af5b-031b83b8de20",
      "label": "resumen_triage",
      "name": "execute_python",
      "app_name": "Shuffle Tools",
      "app_version": "1.2.0",
      "app_id": "",
      "environment": "Shuffle",
      "is_valid": true,
      "isStartNode": false,
      "description": "Arma la nota y el aviso en español con prioridad, runbook y cadena.",
      "authentication_id": "",
      "errors": [],
      "sharing": false,
      "private_id": "",
      "public": false,
      "parameters": [
        {
          "name": "code",
          "value": "import json\n# B89 · resumen de triage en español (sin datos personales: solo referencias).\nv = $validar_y_deduplicar.message\nb89 = $buscar_alerta_b89.body if \"$buscar_alerta_b89.status\" == \"200\" else {}\nitem = (b89.get(\"items\") or [{}])[0] if isinstance(b89, dict) else {}\nlevel = int(v.get(\"level\", 0))\nsev = \"CRÍTICA\" if level >= 12 else \"ALTA\"\nlines = [\n    f\"Regla {v['rule_id']} (nivel {level}): {v['description']}\",\n    f\"Fuente: {v['source']} · cadena de ataque: {'sí' if v['chain'] == 'true' else 'no'}\",\n    f\"Prioridad B89: {item.get('priority', 'pendiente de ingesta')} · alerta B89: {item.get('id', 'sin enlazar')}\",\n    f\"Runbook: {v['runbook']}\",\n    \"Siguiente paso: el analista de guardia acusa en B89 (SLA según prioridad) y sigue el runbook.\",\n    \"B89 Respond no ejecutó ninguna acción con efectos.\",\n]\nrecipients = [{\"emailAddress\": {\"address\": a.strip()}} for a in \"$b89_mail_to\".split(\",\") if \"@\" in a]\nprint(json.dumps({\"title\": v[\"description\"][:120], \"severity_label\": sev, \"incident_id\": item.get(\"incidentId\", \"\"),\n                  \"alert_id\": item.get(\"id\", \"\"), \"note\": \"\\n\".join(lines),\n                  \"mail_text\": \"\\n\".join(lines) + \"\\n\\nConsola: $b89_console\", \"recipients\": recipients}))\n",
          "required": false,
          "multiline": true,
          "id_": "",
          "variant": "STATIC_VALUE",
          "action_field": "",
          "example": "",
          "description": ""
        }
      ],
      "position": {
        "x": 600,
        "y": 0
      },
      "priority": 0,
      "execution_delay": 0
    },
