<!-- B89 provider rules: monitoring only; response actions require the B89 approval workflow. -->
<group name="b89_provider,b89_multisource,">
  <rule id="101216" level="14">
    <if_sid>101200</if_sid>
    <field name="b89_vendor">cloudflare</field>
    <field name="b89_event_type">security_control_disabled</field>
    <description>B89: cambio destructivo en control de seguridad de Cloudflare; verificar actor, recurso y cambio aprobado.</description>
    <options>no_full_log</options>
    <mitre><id>T1562.007</id></mitre>
    <group>b89_cloudflare,b89_defense_evasion,</group>
  </rule>
  <rule id="101217" level="8">
    <if_sid>101200</if_sid>
    <field name="b89_vendor">cloudflare</field>
    <field name="b89_event_type">audit_change</field>
    <description>B89: cambio administrativo en Cloudflare por $(b89_actor) sobre $(b89_product): $(b89_action).</description>
    <options>no_full_log</options>
    <group>b89_cloudflare,b89_change_monitoring,</group>
  </rule>
  <rule id="101218" level="11">
    <if_sid>101200</if_sid>
    <field name="b89_vendor">snyk</field>
    <field name="b89_event_type">vulnerability_found</field>
    <field name="b89_severity" type="pcre2">(?i)^(high|critical)$</field>
    <field name="b89_status" type="pcre2">(?i)^(open|active|new)$</field>
    <description>B89: hallazgo alto/crítico activo en Snyk; valorar exposición, entorno productivo y explotabilidad antes de priorizar.</description>
    <options>no_full_log</options>
    <mitre><id>T1195</id></mitre>
    <group>b89_snyk,b89_vulnerability,</group>
  </rule>
  <rule id="101219" level="13">
    <if_sid>101200</if_sid>
    <field name="b89_vendor">bitdefender</field>
    <field name="b89_event_type">endpoint_incident</field>
    <field name="b89_severity" type="pcre2">(?i)^(high|critical)$</field>
    <field name="b89_status" type="pcre2">(?i)^(open|in_progress)$</field>
    <description>B89: incidente alto/crítico abierto de Bitdefender en endpoint $(b89_endpoint_id).</description>
    <options>no_full_log</options>
    <mitre><id>T1204</id><id>T1059</id></mitre>
    <group>b89_bitdefender,b89_malware,</group>
  </rule>
  <rule id="101220" level="7">
    <if_sid>101200</if_sid>
    <field name="b89_event_type">provider_auth_failed</field>
    <description>B89: el collector de $(b89_vendor) no tiene autorización API (HTTP $(b89_http_status)); la fuente está degradada.</description>
    <options>no_full_log</options>
    <group>b89_source_health,b89_authentication_failed,</group>
  </rule>
  <rule id="101221" level="5">
    <if_sid>101200</if_sid>
    <field name="b89_event_type">provider_api_error</field>
    <description>B89: error de consulta de $(b89_vendor); revisar la salud de la integración.</description>
    <options>no_full_log</options>
    <group>b89_source_health,</group>
  </rule>
  <rule id="101222" level="2">
    <if_sid>101200</if_sid>
    <field name="b89_event_type">provider_recovered</field>
    <description>B89: se restableció la conexión de lectura a $(b89_vendor).</description>
    <options>no_full_log</options>
    <group>b89_source_health,b89_provider_recovered,</group>
  </rule>
</group>