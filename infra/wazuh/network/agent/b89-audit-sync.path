# B89 SOC · reaplica las reglas de auditoría de red cuando el manager distribuye una versión nueva.
[Unit]
Description=B89 SOC: vigila las reglas de auditoria de red distribuidas por Wazuh

[Path]
PathChanged=/var/ossec/etc/shared/b89-audit-network.rules
Unit=b89-audit-sync.service

[Install]
WantedBy=multi-user.target
