# API B89 en el nodo PowerUser. Los valores sensibles están en /opt/b89/secrets/api.env (0600).
# Identidad: Entra real del tenant B89 (login OIDC) JUNTO a las cuentas demo de contraseña, por el
# opt-in explícito B89_DEMO_LOGIN_WITH_ENTRA=true (docs/04-identidad-y-acceso.md). Sin el opt-in,
# production solo admite las cuentas demo con la identidad fija DEMO_DEPLOYMENT_IDENTITY, y
# B89_DEMO_ACCOUNTS en secrets/api.env con la excepción apagada impide arrancar el API.
NODE_ENV=production
B89_PROFILE=production
B89_API_HOST=0.0.0.0
B89_API_PORT=3000
B89_ACCESS_IDENTITY_MODE=entra
B89_ENTRA_TENANT_ID=22ff391c-075c-40a7-bf4b-0a8cd3f4fc6a
B89_ENTRA_CLIENT_ID=8b23cf6c-b012-405f-a419-7273f788a285
B89_ENTRA_AUTHORITY=https://login.microsoftonline.com
B89_ENTRA_REDIRECT_URI=https://${SOC_HOSTNAME}/api/auth/callback
B89_ENTRA_ALLOWED_REDIRECT_URIS=https://${SOC_HOSTNAME}/api/auth/callback
B89_ENTRA_CLIENT_SECRET_REF=secret://b89-soc-dev/entra/client-secret
B89_CONSOLE_BASE_URL=https://${SOC_HOSTNAME}
B89_ACCESS_ALLOWED_CIDRS=0.0.0.0/0,::/0
B89_ACCESS_TRUSTED_PROXY_CIDRS=172.30.89.11/32
B89_SOC_PERSISTENCE=postgres
B89_POSTGRES_HOST=postgres
B89_POSTGRES_PORT=5432
B89_POSTGRES_DATABASE=b89_secops
B89_POSTGRES_USERNAME=b89_soc_runtime
B89_POSTGRES_TLS=true
# Ingesta Wazuh sin Entra: gateway con token estático (scripts/setup-ingestion.sh). El token
# está en /opt/b89/secrets/api.env (B89_WAZUH_GATEWAY_ACCESS_TOKEN).
B89_INGESTION_SOURCE=wazuh
B89_WAZUH_GATEWAY_AUTH=static-token
B89_WAZUH_GATEWAY_BASE_URL=https://wazuh-gateway:8443
B89_INGESTION_INTERVAL=60s
B89_INGESTION_INITIAL_LOOKBACK_MINUTES=60
B89_DEMO_ADMIN_LOGIN_ENABLED=true
B89_DEMO_LOGIN_WITH_ENTRA=true
B89_DEMO_ADMIN_LOGIN_UNTIL=${DEMO_UNTIL}
B89_DEMO_ADMIN_USERNAME=admin@b89.io
# Padrón del grupo de admisión por Microsoft Graph (miembros, dueños y solicitudes de rol en
# «Usuarios y sesiones»). Requiere consentimiento de administrador para el permiso de aplicación
# GroupMember.Read.All (mínimo) o Group.Read.All. El cliente usa el token app-only de
# B89_ENTRA_CLIENT_SECRET y scope graph.microsoft.com/.default. Sin permiso o si el grupo por nombre
# no se puede resolver, el API arranca igual y muestra el estado pendiente; reintenta sin reinicio.
B89_DIRECTORY_SYNC=graph
B89_DIRECTORY_GROUP_NAME=Accesos_SOC
# Correlador privado (services/b89-correlator): lectura para /api/risk/*. Los tokens de lectura
# y de servicio están en /opt/b89/secrets/api.env (bootstrap-correlator.sh).
B89_CORRELATOR_URL=http://correlator:8080
# Teams solo recibe lo que requiere atención (P1/P2 frescas e incidentes, y el resumen de
# P1/P2 agrupadas o atrasadas). El resumen periódico P3/P4 queda apagado: se revisa en la cola.
B89_NOTIFY_DIGEST_MINUTES=0
