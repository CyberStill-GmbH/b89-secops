<!--
  B89 SOC · detección como código · detections/linux/ssh-bruteforce-success (metadata.yaml).
  Acceso SSH exitoso desde una IP que falló antes (5712/5720/5763 o cualquier regla del grupo
  authentication_failures) en 30 min. La 40112 oficial mira solo 4 min y un atacante lento la evade.
  Es hija de 5715 y de 40112: si 40112 gana el primer nivel, la B89 desciende y prevalece.
  Datos reales: el nodo b89-soc-dev-node (agente 001) recibe fuerza bruta SSH desde Internet a diario.
  Rango B89 Linux: 101750-101769. Se instala como b89_soc_linux_ssh_bruteforce_success.xml.
-->
<group name="syslog,sshd,b89_linux,">
  <rule id="101750" level="13" timeframe="1800">
    <if_sid>5715, 40112</if_sid>
    <if_matched_group>authentication_failures</if_matched_group>
    <same_source_ip />
    <description>B89 Linux: acceso SSH exitoso de $(dstuser) desde $(srcip) tras fuerza bruta desde la misma IP en 30 min.</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1078.003</id>
      <id>T1021.004</id>
    </mitre>
    <group>b89_initial_access,b89_attack_chain,</group>
  </rule>
</group>
