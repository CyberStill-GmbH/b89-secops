<!--
  B89 SOC · detección como código · detections/linux/network-auditd (metadata.yaml).
  Llamadas de red auditadas por auditd (wazuh/manager/policy/shared/linux-servers/b89-audit-network.rules):
  connect/bind/accept de sesiones interactivas (auid>=1000), connect de www-data y ejecución de
  herramientas de red. La IP sale del registro SOCKADDR enriquecido (decoder hermano auditd-syscall en
  infra/wazuh/network/decoders/b89_network_decoders.xml → dstip/dstport). Las claves b89_net_* no están en
  la lista audit-keys oficial: ninguna regla 807xx las captura antes.
  Orden de hermanos = prioridad. Se instala como b89_soc_linux_network_auditd.xml.
-->
<group name="audit,b89_network,b89_linux,">

  <rule id="101810" level="0">
    <if_sid>80700</if_sid>
    <field name="audit.key">^b89_net_</field>
    <description>B89 Linux: llamada de red auditada ($(audit.key)) de $(audit.exe).</description>
    <group>b89_audit_net,</group>
  </rule>

  <rule id="101812" level="12">
    <if_sid>101810</if_sid>
    <field name="audit.key">^b89_net_accept$|^b89_net_bind$</field>
    <field name="audit.exe" type="pcre2">/(bash|sh|dash|zsh|ksh|nc|ncat|netcat|nc\.openbsd|nc\.traditional|socat|perl|php[0-9.-]*|ruby)$</field>
    <description>B89 Linux: $(audit.exe) de una sesión interactiva (auid $(audit.auid)) abrió o aceptó una escucha de red (posible bind shell).</description>
    <mitre>
      <id>T1059.004</id>
      <id>T1571</id>
    </mitre>
    <group>b89_audit_net,b89_attack,</group>
  </rule>

  <rule id="101813" level="10">
    <if_sid>101810</if_sid>
    <field name="audit.key">^b89_net_tools$</field>
    <description>B89 Linux: ejecución de herramienta de red o captura $(audit.exe) por auid $(audit.auid) (uid $(audit.uid)).</description>
    <mitre>
      <id>T1046</id>
      <id>T1040</id>
    </mitre>
    <group>b89_audit_net,</group>
  </rule>

  <rule id="101814" level="12">
    <if_sid>101810</if_sid>
    <field name="audit.key">^b89_net_connect$</field>
    <field name="audit.exe" type="pcre2">/(bash|sh|dash|zsh|ksh|nc|ncat|netcat|nc\.openbsd|nc\.traditional|socat|perl|php[0-9.-]*|ruby|telnet\.netkit|telnet)$</field>
    <dstip negate="yes" type="pcre2">^127\.|^::1$</dstip>
    <description>B89 Linux: $(audit.exe) (auid $(audit.auid)) se conectó a $(dstip):$(dstport); patrón de reverse shell.</description>
    <mitre>
      <id>T1059.004</id>
      <id>T1071</id>
    </mitre>
    <group>b89_audit_net,b89_attack,</group>
  </rule>

  <rule id="101815" level="10">
    <if_sid>101810</if_sid>
    <field name="audit.key">^b89_net_connect$</field>
    <field name="audit.exe" type="pcre2">/(nmap|masscan|zmap|rustscan|naabu)$</field>
    <description>B89 Linux: escáner de red $(audit.exe) (auid $(audit.auid)) conectando a $(dstip):$(dstport).</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>b89_audit_net,b89_attack,</group>
  </rule>

  <rule id="101816" level="10">
    <if_sid>101810</if_sid>
    <field name="audit.key">^b89_net_svc$</field>
    <dstip negate="yes" type="pcre2">^(10\.|127\.|169\.254\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)|^::1$</dstip>
    <description>B89 Linux: la cuenta de servicio web (uid $(audit.uid), $(audit.exe)) abrió conexión a $(dstip):$(dstport) (posible webshell o C2).</description>
    <mitre>
      <id>T1505.003</id>
      <id>T1071</id>
    </mitre>
    <group>b89_audit_net,b89_attack,</group>
  </rule>

  <rule id="101818" level="5">
    <if_sid>101810</if_sid>
    <field name="audit.key">^b89_net_accept$|^b89_net_bind$</field>
    <dstip negate="yes" type="pcre2">^127\.|^::1$</dstip>
    <description>B89 Linux: proceso de sesión interactiva $(audit.exe) (auid $(audit.auid)) abrió o aceptó una escucha de red en $(dstip):$(dstport).</description>
    <mitre>
      <id>T1571</id>
    </mitre>
    <group>b89_audit_net,</group>
  </rule>

  <rule id="101811" level="0">
    <if_sid>101810</if_sid>
    <dstip type="pcre2">^(10\.|127\.|0\.|169\.254\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.)|^::1$|^fe80:|^f[cd][0-9a-f]{2}:</dstip>
    <description>B89 Linux: llamada de red de sesión interactiva a destino interno $(dstip):$(dstport) ($(audit.exe)).</description>
    <group>b89_audit_net,</group>
  </rule>

  <rule id="101817" level="3">
    <if_sid>101810</if_sid>
    <field name="audit.key">^b89_net_connect$</field>
    <dstip>\.|:</dstip>
    <description>B89 Linux: $(audit.exe) de una sesión interactiva (auid $(audit.auid)) se conectó a $(dstip):$(dstport).</description>
    <group>b89_audit_net,</group>
  </rule>

</group>
