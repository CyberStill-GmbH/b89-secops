<!--
  B89 SOC · detección como código · detections/linux/network-connections (metadata.yaml).
  Puertos en escucha y conexiones TCP del host, desde el command monitoring del grupo linux-servers
  (wazuh/manager/policy/shared/linux-servers/b89-netconn.sh, decoder b89-netconn en
  infra/wazuh/network/decoders/b89_network_decoders.xml). Docs: docs/18-visibilidad-de-red-y-capacidades-wazuh.md.
  - 101800: foto de escuchas con check_diff (misma lógica que la 533 oficial, alias propio para no
    mezclarse con el netstat por defecto del agente).
  - 101801-101809: una línea por escucha o conexión NUEVA. Orden de hermanos = prioridad (gana el primero).
  Rango B89 red: 101800-101899 (catalog.yaml). Se instala como b89_soc_linux_network_connections.xml.
-->
<group name="b89_network,b89_linux,">

  <rule id="101800" level="7">
    <if_sid>530</if_sid>
    <match>ossec: output: 'b89 listening ports'</match>
    <check_diff />
    <description>B89 Linux: cambiaron los puertos en escucha del host (se abrió o se cerró uno).</description>
    <mitre>
      <id>T1571</id>
    </mitre>
    <group>b89_listening_ports,</group>
  </rule>

  <rule id="101801" level="0">
    <if_sid>530</if_sid>
    <field name="b89.net.type">^listen$|^conn$|^truncated$|^error$</field>
    <description>B89 Linux: evento de red del host ($(b89.net.type) $(b89.net.direction)).</description>
    <group>b89_netconn,</group>
  </rule>

  <!-- Escuchas nuevas -->
  <rule id="101802" level="0">
    <if_sid>101801</if_sid>
    <field name="b89.net.type">^listen$</field>
    <field name="dstip" type="pcre2">^127\.|^::1$</field>
    <description>B89 Linux: nueva escucha solo en loopback ($(dstip):$(dstport), $(b89.net.process)).</description>
    <group>b89_netconn,</group>
  </rule>

  <rule id="101803" level="12">
    <if_sid>101801</if_sid>
    <field name="b89.net.type">^listen$</field>
    <field name="b89.net.process" type="pcre2">^(bash|sh|dash|zsh|ksh|nc|ncat|netcat|nc\.openbsd|nc\.traditional|socat|python[0-9.]*|perl|php[0-9.-]*|ruby|lua|telnet)$</field>
    <description>B89 Linux: shell, netcat o intérprete $(b89.net.process) escucha en $(dstip):$(dstport)/$(protocol) (posible bind shell o túnel).</description>
    <mitre>
      <id>T1059.004</id>
      <id>T1571</id>
    </mitre>
    <group>b89_netconn,b89_attack,</group>
  </rule>

  <rule id="101804" level="0">
    <if_sid>101801</if_sid>
    <field name="b89.net.type">^listen$</field>
    <list field="dstport" lookup="match_key">etc/lists/b89-expected-listeners</list>
    <description>B89 Linux: escucha esperada $(dstip):$(dstport)/$(protocol) ($(b89.net.process)).</description>
    <group>b89_netconn,</group>
  </rule>

  <rule id="101805" level="8">
    <if_sid>101801</if_sid>
    <field name="b89.net.type">^listen$</field>
    <description>B89 Linux: nuevo puerto en escucha no esperado $(dstip):$(dstport)/$(protocol) de $(b89.net.process) (uid $(b89.net.uid)).</description>
    <mitre>
      <id>T1571</id>
    </mitre>
    <group>b89_netconn,</group>
  </rule>

  <!-- Conexiones TCP nuevas -->
  <rule id="101806" level="0">
    <if_sid>101801</if_sid>
    <field name="b89.net.type">^conn$</field>
    <regex type="pcre2">dir=out .* dst=(10\.|127\.|0\.|169\.254\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.|::1 |fe80:|f[cd][0-9a-f]{2}:)|dir=in .* src=(10\.|127\.|0\.|169\.254\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.|::1 |fe80:|f[cd][0-9a-f]{2}:)</regex>
    <description>B89 Linux: conexión TCP interna $(b89.net.direction) $(srcip) → $(dstip):$(dstport) ($(b89.net.process)).</description>
    <group>b89_netconn,</group>
  </rule>

  <rule id="101807" level="10">
    <if_sid>101801</if_sid>
    <field name="b89.net.type">^conn$</field>
    <field name="b89.net.direction">^out$</field>
    <field name="b89.net.process" type="pcre2">^(bash|sh|dash|zsh|ksh|nc|ncat|netcat|nc\.openbsd|nc\.traditional|socat|perl|php[0-9.-]*|ruby|lua|telnet)$</field>
    <description>B89 Linux: $(b89.net.process) abrió conexión saliente a $(dstip):$(dstport) (uid $(b89.net.uid)); patrón de reverse shell.</description>
    <mitre>
      <id>T1059.004</id>
      <id>T1071</id>
    </mitre>
    <group>b89_netconn,b89_attack,</group>
  </rule>

  <rule id="101808" level="5">
    <if_sid>101801</if_sid>
    <field name="b89.net.type">^conn$</field>
    <field name="b89.net.direction">^out$</field>
    <list field="dstip" lookup="not_address_match_key">etc/lists/b89-egress-known</list>
    <description>B89 Linux: conexión saliente a destino poco común $(dstip):$(dstport) desde $(b89.net.process) (uid $(b89.net.uid)).</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <group>b89_netconn,b89_rare_destination,</group>
  </rule>

  <rule id="101809" level="3">
    <if_sid>101801</if_sid>
    <field name="b89.net.type">^conn$</field>
    <field name="b89.net.direction">^in$</field>
    <description>B89 Linux: conexión entrante desde $(srcip) al puerto $(dstport) ($(b89.net.process)).</description>
    <mitre>
      <id>T1133</id>
    </mitre>
    <group>b89_netconn,</group>
  </rule>

</group>
