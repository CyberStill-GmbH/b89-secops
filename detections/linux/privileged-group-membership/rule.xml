<!--
  B89 SOC · detección como código · detections/linux/privileged-group-membership (metadata.yaml).
  Usuario agregado a un grupo que equivale a root (sudo, wheel, admin, root, docker, lxd, disk) o que
  lee secretos y logs (shadow, adm). La oficial 2961 solo eleva sudo y a nivel 5.
  Limitación: solo el decoder gpasswd extrae el grupo; `usermod -aG` no tiene decoder (backlog BL-L03).
  Rango B89 Linux: 101750-101769. Se instala como b89_soc_linux_privileged_group_membership.xml.
-->
<group name="syslog,b89_linux,">
  <rule id="101752" level="10">
    <if_sid>2960, 2961</if_sid>
    <field name="group" type="pcre2">^(sudo|wheel|admin|root|docker|lxd|disk|shadow|adm)$</field>
    <description>B89 Linux: $(srcuser) agregó a $(dstuser) al grupo privilegiado $(group).</description>
    <mitre>
      <id>T1098.007</id>
      <id>T1548</id>
    </mitre>
    <group>b89_privilege_escalation,</group>
  </rule>
</group>
