<!--
  B89 SOC · detección como código · detections/entra/privileged-role-assignment (metadata.yaml).
  Refina 100520 (rol privilegiado de Entra) cuando el rol es tier 0: control total del tenant.
  Rango B89: 101704 (bloque M365/Entra 101700-101709). Se instala como b89_soc_entra_privileged_role_assignment.xml.
  Mismo gate que 100520: b89_pending_provider_evidence hasta tener un registro real redactado como fixture.
-->
<group name="office365,b89_m365,">
  <rule id="101704" level="14">
    <if_sid>100520</if_sid>
    <field name="office365.ModifiedProperties" type="pcre2">(Global Administrator|Privileged Role Administrator|Privileged Authentication Administrator|Company Administrator)</field>
    <description>B89 Entra: $(office365.UserId) asignó un rol tier 0 (Global, Privileged Role o Privileged Authentication Administrator) a $(office365.ObjectId).</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1098.003</id>
    </mitre>
    <group>azure_ad,b89_privilege_escalation,b89_tier0,b89_pending_provider_evidence,</group>
  </rule>
</group>
